      "seed": 438337342,
      "version": 535,
      "versionNonce": 1724352190,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790850530325,
      "created": 1790849008890,
      "link": null,
      "locked": false,
      "text": "Requirements\nHome:\n- Show the data of current day include the rain percent\n\nSearch:\n- Only support online search into 2 step\n  - Request autocomplete to select\n  - Do search base on the selected one\n\nLogin\n- Support OAUTH use firebase free\n- Enable google login \n- Enable apple login\n- Support logout/remove account\n\nProfile\n- Allow to edit profile\n- Separate the avatar url",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements\nHome:\n- Show the data of current day include the rain percent\n\nSearch:\n- Only support online search into 2 step\n  - Request autocomplete to select\n  - Do search base on the selected one\n\nLogin\n- Support OAUTH use firebase free\n- Enable google login \n- Enable apple login\n- Support logout/remove account\n\nProfile\n- Allow to edit profile\n- Separate the avatar url",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
