    {
      "id": "ncqXrdjcHYmsPDMyEzg79",
      "type": "text",
      "x": 486,
      "y": 881.6787719726562,
      "width": 546.199951171875,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
